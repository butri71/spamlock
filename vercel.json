{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/index_old.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/terms_old.html",
      "destination": "/terms.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(site\\.css|site\\.js|consent\\.js|lang\\.js|help\\.css|help\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(film|media)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/(favicon\\.png|apple-touch-icon\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}