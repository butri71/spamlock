{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/index_old.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/terms_old.html",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/it/index.html",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/es/index.html",
      "destination": "/es/",
      "permanent": true
    },
    {
      "source": "/help/index.html",
      "destination": "/help/",
      "permanent": true
    },
    {
      "source": "/it/guide/index.html",
      "destination": "/it/guide/",
      "permanent": true
    },
    {
      "source": "/es/guia/index.html",
      "destination": "/es/guia/",
      "permanent": true
    },
    {
      "source": "/es/guia/me-han-hackeado-instagram-facebook-o-whatsapp.html",
      "destination": "/es/guia/me-han-hackeado-instagram-facebook-o-x.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(site\\.css|site\\.js|consent\\.js|lang\\.js|help\\.css|help\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(film|media)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/(favicon\\.png|apple-touch-icon\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
